---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import siteConfig from '../../site.config.json';

const { app, contact } = siteConfig;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(`${app.name} — Data deletion request`)}`;
---

<BaseLayout title={`Data Deletion | ${app.name}`} description={`Request deletion of your ${app.name} account and data.`}>
	<SiteNav />

	<main class="wrapper info-page">
		<div class="page-head">
			<p class="eyebrow">{app.name}</p>
			<h1>Delete your account and data</h1>
			<p class="lede">You can request deletion of your {app.name} account and all associated data at any time. This page explains how, and what happens next.</p>
		</div>

		<div class="info-card">
			<h2>How to request deletion</h2>
			<p>Email us from the address linked to your {app.name} account. Using the button below pre-fills the subject line for you.</p>
			<div class="email-line">
				<a href={mailto} class="btn btn-primary">Request data deletion</a>
			</div>
			<p>Please include in your message:</p>
			<ul>
				<li>The email address associated with your account</li>
				<li>Whether you use {app.name} on iOS, Android, or both</li>
			</ul>
		</div>

		<div class="info-card">
			<h2>What happens next</h2>
			<ul>
				<li>We'll confirm your request by replying to the email address on your account.</li>
				<li>Your account and associated data will be permanently deleted within 30 days.</li>
				<li>You'll receive a final confirmation email once deletion is complete.</li>
			</ul>
			<p>Some records may be retained where required by law (for example, transaction records) — see our <a href="/privacy/">Privacy Policy</a> for details. Update this page to accurately reflect what your app deletes and retains.</p>
		</div>
	</main>

	<SiteFooter />
</BaseLayout>
