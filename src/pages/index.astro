---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoreButtons from '../components/StoreButtons.astro';
import siteConfig from '../../site.config.json';

import phoneHero from '../../public/assets/phone-frame.png';
import phoneShowcase from '../../public/assets/phone2.png';

const { app, meta } = siteConfig;

// All copy on this page is deliberately generic placeholder content.
// Rewrite it (or have an AI rewrite it) to describe your actual app —
// the layout works with copy of roughly the same length.
---

<BaseLayout title={meta.title} description={meta.description} image={meta.ogImagePath}>
	<SiteNav />

	<main>
		<!-- Hero -->
		<section class="hero">
			<div class="wrapper hero-grid">
				<div class="hero-copy">
					<p class="hero-badge"><span class="dot"></span>Now available on iOS and Android</p>
					<h1>Do more of what matters, right from your phone</h1>
					<p class="hero-tagline">{app.tagline}</p>
					<StoreButtons />
					<p class="hero-note">Free to download &middot; No credit card required</p>
				</div>
				<div class="hero-visual">
					<Image src={phoneHero} alt={`${app.name} running on a phone`} width={480} height={480} class="phone-image" loading="eager" />
				</div>
			</div>
		</section>

		<!-- Stats -->
		<section class="stats" aria-label="Highlights">
			<div class="wrapper stats-grid">
				<div class="stat"><strong>50k+</strong><span>Downloads and counting</span></div>
				<div class="stat"><strong>4.9</strong><span>Average App Store rating</span></div>
				<div class="stat"><strong>120+</strong><span>Countries around the world</span></div>
			</div>
		</section>

		<!-- Features -->
		<section id="features" class="section">
			<div class="wrapper">
				<div class="section-head">
					<p class="eyebrow">Features</p>
					<h2>Everything you need, nothing you don't</h2>
					<p>Six short feature blurbs live here. Swap each one for something your app actually does.</p>
				</div>
				<div class="feature-grid">
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
						</div>
						<h3>Fast by default</h3>
						<p>Opens instantly and stays smooth, even on older devices. No spinners, no waiting around.</p>
					</div>
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
						</div>
						<h3>Private and secure</h3>
						<p>Your data is encrypted in transit and at rest. We never sell it, and you can delete it any time.</p>
					</div>
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19a4.5 4.5 0 1 0 0-9h-1.1A7 7 0 1 0 5 15.7" /><path d="M12 12v9" /><path d="m8 17 4-4 4 4" /></svg>
						</div>
						<h3>Syncs everywhere</h3>
						<p>Pick up right where you left off. Everything stays in sync across all of your devices.</p>
					</div>
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
						</div>
						<h3>Smart notifications</h3>
						<p>Get nudged about the things that matter and nothing else. Quiet hours are built in.</p>
					</div>
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16" /><path d="m7 14 4-4 4 4 5-5" /></svg>
						</div>
						<h3>Insights that help</h3>
						<p>Simple charts show your progress over time, so you always know how you're doing.</p>
					</div>
					<div class="feature-card">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 14.5 16 10 4 20" /><circle cx="9" cy="9" r="2" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
						</div>
						<h3>Delightful design</h3>
						<p>A clean, thoughtful interface that feels at home on your phone — including full dark mode.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- How it works -->
		<section id="how-it-works" class="section section-alt">
			<div class="wrapper">
				<div class="section-head">
					<p class="eyebrow">How it works</p>
					<h2>Up and running in minutes</h2>
					<p>Three steps between your users and the value your app delivers. Keep them short and concrete.</p>
				</div>
				<div class="steps">
					<div class="step">
						<div class="step-number">1</div>
						<h3>Download the app</h3>
						<p>Grab it free from the App Store or Google Play — it takes less than a minute.</p>
					</div>
					<div class="step">
						<div class="step-number">2</div>
						<h3>Create your account</h3>
						<p>Sign up with your email or a single tap using your Google or Apple account.</p>
					</div>
					<div class="step">
						<div class="step-number">3</div>
						<h3>Make it yours</h3>
						<p>Set a couple of preferences and you're done. The app takes care of the rest.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Showcase -->
		<section class="section">
			<div class="wrapper showcase">
				<div class="showcase-visual">
					<Image src={phoneShowcase} alt={`A screen from ${app.name}`} width={480} height={480} class="phone-image" />
				</div>
				<div class="showcase-copy">
					<p class="eyebrow">Designed for real life</p>
					<h2>Built to stay out of your way</h2>
					<p>Use this section to show off a favourite screen and explain the thinking behind it. One good screenshot beats three paragraphs.</p>
					<ul class="checklist">
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m8.5 12.5 2.5 2.5 5-5.5" /></svg>
							<span>A clean, focused interface with no clutter</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m8.5 12.5 2.5 2.5 5-5.5" /></svg>
							<span>Works offline — everything syncs when you're back</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m8.5 12.5 2.5 2.5 5-5.5" /></svg>
							<span>Accessible from the ground up, on every screen</span>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Testimonials -->
		<section class="section section-alt">
			<div class="wrapper">
				<div class="section-head">
					<p class="eyebrow">What people say</p>
					<h2>Loved by people like you</h2>
					<p>Replace these with real quotes from your beta testers or store reviews as soon as you have them.</p>
				</div>
				<div class="testimonial-grid">
					<div class="testimonial-card">
						<div class="stars" aria-label="5 out of 5 stars">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
						</div>
						<blockquote>"I tried a handful of apps like this and deleted them all within a week. This is the one that stuck — it just fits into my day."</blockquote>
						<div class="testimonial-author">
							<div class="avatar">JM</div>
							<div><strong>Jordan M.</strong><span>Early adopter</span></div>
						</div>
					</div>
					<div class="testimonial-card">
						<div class="stars" aria-label="5 out of 5 stars">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
						</div>
						<blockquote>"Beautifully simple. My favourite part is that it does exactly what it promises and then gets out of the way."</blockquote>
						<div class="testimonial-author">
							<div class="avatar">SK</div>
							<div><strong>Sam K.</strong><span>Beta tester</span></div>
						</div>
					</div>
					<div class="testimonial-card">
						<div class="stars" aria-label="5 out of 5 stars">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
						</div>
						<blockquote>"I recommend it to everyone. Setup took two minutes and it's been part of my routine every single day since."</blockquote>
						<div class="testimonial-author">
							<div class="avatar">AR</div>
							<div><strong>Alex R.</strong><span>Daily user</span></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section id="faq" class="section">
			<div class="wrapper">
				<div class="section-head">
					<p class="eyebrow">FAQ</p>
					<h2>Frequently asked questions</h2>
					<p>Answer the questions people actually ask. These four are a sensible starting point for most apps.</p>
				</div>
				<div class="faq-list">
					<details class="faq-item">
						<summary>Is {app.name} free?</summary>
						<p>Yes — downloading and using the core app is completely free. If you offer a paid tier, this is the place to explain what it adds and what it costs.</p>
					</details>
					<details class="faq-item">
						<summary>Which devices are supported?</summary>
						<p>{app.name} runs on iPhone and Android phones. List your minimum OS versions here once you know them (for example, iOS 16+ and Android 10+).</p>
					</details>
					<details class="faq-item">
						<summary>How is my data handled?</summary>
						<p>The full details are in our <a href="/privacy/">Privacy Policy</a>, and you can request deletion of your account and data at any time from the <a href="/data-deletion/">data deletion page</a>.</p>
					</details>
					<details class="faq-item">
						<summary>How do I get help?</summary>
						<p>Head over to the <a href="/support/">support page</a> and email us — a real person reads every message, and we aim to reply within two business days.</p>
					</details>
				</div>
			</div>
		</section>

		<!-- Download CTA -->
		<section id="download" class="section">
			<div class="wrapper">
				<div class="cta-band">
					<h2>Ready to get started?</h2>
					<p>Download {app.name} free today and see for yourself. It takes less than a minute.</p>
					<StoreButtons />
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</BaseLayout>
