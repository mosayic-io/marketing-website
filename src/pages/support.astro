---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import siteConfig from '../../site.config.json';

const { app, contact } = siteConfig;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(`${app.name} — Support request`)}`;
---

<BaseLayout title={`Support | ${app.name}`} description={`Get help with ${app.name}.`}>
	<SiteNav />

	<main class="wrapper info-page">
		<div class="page-head">
			<p class="eyebrow">{app.name}</p>
			<h1>Support</h1>
			<p class="lede">Something not working the way it should? We'll get you sorted.</p>
		</div>

		<div class="info-card">
			<h2>Email support</h2>
			<p>Send us an email describing the problem and we'll get back to you within two business days.</p>
			<div class="email-line">
				<a href={mailto} class="btn btn-primary">Email {contact.email}</a>
			</div>
			<p>To help us resolve things quickly, please include:</p>
			<ul>
				<li>The device you're using (for example, iPhone 15 or Pixel 9)</li>
				<li>Your operating system version (iOS or Android)</li>
				<li>What you were doing when the problem happened</li>
				<li>A screenshot, if you have one</li>
			</ul>
		</div>

		<div class="info-card">
			<h2>Common questions</h2>
			<p>Before you write, it's worth a quick look at the <a href="/#faq">FAQ</a> — the most common questions are answered there. For anything about your data, see the <a href="/privacy/">Privacy Policy</a> or the <a href="/data-deletion/">data deletion page</a>.</p>
		</div>
	</main>

	<SiteFooter />
</BaseLayout>
