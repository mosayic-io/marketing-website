---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import siteConfig from '../../site.config.json';

const { app, contact } = siteConfig;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(`${app.name} — General enquiry`)}`;
---

<BaseLayout title={`Contact Us | ${app.name}`} description={`Get in touch with the ${app.name} team.`}>
	<SiteNav />

	<main class="wrapper info-page">
		<div class="page-head">
			<p class="eyebrow">{app.name}</p>
			<h1>Contact us</h1>
			<p class="lede">Questions, feedback, press, partnerships — we'd love to hear from you.</p>
		</div>

		<div class="info-card">
			<h2>Send us an email</h2>
			<p>The fastest way to reach us is by email. A real person reads every message, and we aim to reply within two business days.</p>
			<div class="email-line">
				<a href={mailto} class="btn btn-primary">Email {contact.email}</a>
			</div>
			<p>Looking for help with the app itself? The <a href="/support/">support page</a> explains what to include so we can help you faster.</p>
		</div>
	</main>

	<SiteFooter />
</BaseLayout>
