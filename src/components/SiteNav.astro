---
import siteConfig from '../../site.config.json';

const { app } = siteConfig;
---

<header class="site-nav">
	<nav class="wrapper nav-inner" aria-label="Main">
		<a href="/" class="brand">
			<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
				<rect width="64" height="64" rx="14" fill="var(--brand)" />
				<path d="M32 12c2 11 9 18 20 20-11 2-18 9-20 20-2-11-9-18-20-20 11-2 18-9 20-20z" fill="#fff" />
			</svg>
			<span>{app.name}</span>
		</a>
		<div class="nav-links">
			<a href="/#features">Features</a>
			<a href="/#how-it-works">How it works</a>
			<a href="/#faq">FAQ</a>
		</div>
		<a href="/#download" class="btn btn-primary btn-sm">Get the app</a>
	</nav>
</header>
