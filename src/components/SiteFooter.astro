---
import siteConfig from '../../site.config.json';

const { app, contact } = siteConfig;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrapper footer-grid">
		<div class="footer-brand">
			<a href="/" class="brand">
				<svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
					<rect width="64" height="64" rx="14" fill="var(--brand)" />
					<path d="M32 12c2 11 9 18 20 20-11 2-18 9-20 20-2-11-9-18-20-20 11-2 18-9 20-20z" fill="#fff" />
				</svg>
				<span>{app.name}</span>
			</a>
			<p>{app.tagline}</p>
		</div>
		<nav class="footer-col" aria-label="Product">
			<h3>Product</h3>
			<a href="/#features">Features</a>
			<a href="/#how-it-works">How it works</a>
			<a href="/#faq">FAQ</a>
			<a href="/#download">Download</a>
		</nav>
		<nav class="footer-col" aria-label="Support">
			<h3>Support</h3>
			<a href="/contact/">Contact us</a>
			<a href="/support/">Get help</a>
			<a href="/data-deletion/">Delete your data</a>
			<a href={`mailto:${contact.email}`}>{contact.email}</a>
		</nav>
		<nav class="footer-col" aria-label="Legal">
			<h3>Legal</h3>
			<a href="/privacy/">Privacy Policy</a>
			<a href="/terms/">Terms &amp; Conditions</a>
		</nav>
	</div>
	<div class="wrapper footer-bottom">
		<p>&copy; {currentYear} {app.name}. All rights reserved.</p>
	</div>
</footer>
